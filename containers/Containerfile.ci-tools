# Layer CI prerequisites onto the existing target image without changing its
# default Rust/harness versions. Pin BASE_IMAGE to its locally inspected image ID.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG BASE_USER=hel
USER root
COPY scripts/install-ci-go.sh /usr/local/libexec/mergemarshall/install-ci-go.sh
COPY scripts/install-ci-shellcheck.sh /usr/local/libexec/mergemarshall/install-ci-shellcheck.sh
RUN sh /usr/local/libexec/mergemarshall/install-ci-go.sh \
    && sh /usr/local/libexec/mergemarshall/install-ci-shellcheck.sh \
    && go env GOROOT \
    && bash -lc 'go version && command -v gofmt && shellcheck --version'
USER ${BASE_USER}
ARG BIFROST_RUST_TOOLCHAIN=1.99.1
# Bedrock can retain an older base than the ordinary Podman target. Install the
# project's pinned toolchain alongside its existing defaults so fresh sessions
# have the formatter and Clippy as well as rustc/Cargo.
RUN bash -lc 'rustup toolchain install "${BIFROST_RUST_TOOLCHAIN}" --profile minimal --component clippy --component rustfmt \
    && rustup run "${BIFROST_RUST_TOOLCHAIN}" rustfmt --version \
    && rustup run "${BIFROST_RUST_TOOLCHAIN}" cargo-clippy --version'
RUN go version && bash -lc 'go version && command -v gofmt && shellcheck --version'
